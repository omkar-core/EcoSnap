rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Lock all by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Only authenticated user can read/write their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.keys().hasAny(['points', 'displayName', 'role'])
                   && (request.resource.data.points is number || !('points' in request.resource.data));
    }

    match /users/{userId}/scans/{scanId} {
      // Only authenticated user can read/write their own nested scans
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['wasteType', 'points'])
                    && request.resource.data.points is number;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    match /community_scans/{scanId} {
      // Authenticated users can read community global scans, but only their creator can alter them 
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['wasteType', 'points'])
                    && request.resource.data.points is number;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
