rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Lock all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /uploads/{userId}/{allFiles=**} {
      // Only allow authenticated user to upload/read their own images
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                   && request.resource.contentType.matches('image/.*'); // Only images
    }

    match /public/{allFiles=**} {
      // Public assets that any authenticated user can read
      allow read: if request.auth != null;
      allow write: if false; // Only admin via SDK
    }
  }
}
